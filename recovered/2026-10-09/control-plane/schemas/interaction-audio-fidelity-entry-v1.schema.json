{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "InteractionAudioFidelityEntry.v1",
  "type": "object",
  "required": [
    "interaction_id",
    "game",
    "room_or_context",
    "trigger_or_object",
    "branch",
    "classification",
    "source_evidence",
    "runtime_event",
    "test_status"
  ],
  "properties": {
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "room_or_context": {
      "type": "string"
    },
    "trigger_or_object": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "SOURCE_AUDIO_VERIFIED",
        "NO_AUDIO_BY_SOURCE",
        "HOLD_UNRESOLVED"
      ]
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "asset_if_any": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_sha256_if_any": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "runtime_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    }
  },
  "additionalProperties": true
}