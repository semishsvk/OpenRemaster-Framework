{
  "$id": "urn:openremaster:SemanticPopulationGuard.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "definitions": {
      "items": {
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expectations": {
      "properties": {
        "active_by_kind": {
          "additionalProperties": {
            "properties": {
              "max": {
                "minimum": 0,
                "type": "integer"
              },
              "min": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "min",
              "max"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "evidence_path": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "CORPUS_AND_RUNTIME_VERIFIED",
            "HYPOTHESIS"
          ]
        }
      },
      "required": [
        "status",
        "evidence_path",
        "evidence_sha256",
        "active_by_kind"
      ],
      "type": "object"
    },
    "instances": {
      "items": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "definition_id": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "parent_instance_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "definition_id",
          "active"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "SemanticPopulationGuard.v1"
    }
  },
  "required": [
    "schema",
    "definitions",
    "instances",
    "expectations"
  ],
  "title": "SemanticPopulationGuard.v1",
  "type": "object"
}
