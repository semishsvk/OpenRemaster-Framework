{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openremaster:dual-trust:worker-observation:v1",
  "title": "Untrusted worker observation; never authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "worker_identity", "trust_class", "capabilities", "project_scope", "environment", "owner_lease", "resource_allocation", "admission_status", "attestation_status", "last_verified_heartbeat", "current_task", "checkpoint", "audit_references", "release_eligible"],
  "properties": {
    "schema": {"const": "OpenRemaster.WorkerObservation.v1"},
    "worker_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "trust_class": {"enum": ["DEVELOPMENT", "SECURE_PRODUCTION"]},
    "capabilities": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "project_scope": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment": {"type": "string", "minLength": 1, "maxLength": 1024},
    "owner_lease": {"type": ["string", "null"], "maxLength": 256},
    "resource_allocation": {"type": ["string", "null"], "maxLength": 1024},
    "admission_status": {"enum": ["UNKNOWN", "HOLD", "OBSERVED_LOCAL_DEV", "EXTERNAL_EVIDENCE_PENDING_VERIFICATION"]},
    "attestation_status": {"enum": ["UNKNOWN", "MISSING", "TEST_ONLY", "EXTERNAL_EVIDENCE_PENDING_VERIFICATION"]},
    "last_verified_heartbeat": {"type": ["string", "null"], "format": "date-time"},
    "current_task": {"type": ["string", "null"], "maxLength": 256},
    "checkpoint": {"type": ["string", "null"], "maxLength": 1024},
    "audit_references": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1}},
    "release_eligible": {"const": false}
  }
}
