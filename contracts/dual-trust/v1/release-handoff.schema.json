{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openremaster:dual-trust:release-handoff:v1",
  "title": "Release handoff evidence references; not authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "commit", "project", "build_recipe_sha256", "dependencies_sha256", "test_profile", "candidate_evidence", "source_integrity", "fidelity_requirements", "security_policy_version", "release_request"],
  "properties": {
    "schema": {"const": "OpenRemaster.ReleaseHandoff.v1"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 2048},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"},
    "project": {"type": "string", "minLength": 1, "maxLength": 256},
    "build_recipe_sha256": {"$ref": "#/$defs/sha256"},
    "dependencies_sha256": {"$ref": "#/$defs/sha256"},
    "test_profile": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_evidence": {"$ref": "#/$defs/references"},
    "source_integrity": {"$ref": "#/$defs/references"},
    "fidelity_requirements": {"$ref": "#/$defs/references"},
    "security_policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "release_request": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "references": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  }
}
