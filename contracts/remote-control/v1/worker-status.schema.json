{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/semishsvk/OpenRemaster-Framework/contracts/remote-control/v1/worker-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "observed_utc",
    "state",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "observed_utc": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "UNKNOWN",
        "OFFLINE",
        "READY",
        "BUSY"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "synthetic.validate"
        ]
      },
      "maxItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
