{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional source-only naming reference metadata",
  "type": "object",
  "if": {
    "required": [
      "orf_component_ref"
    ]
  },
  "then": {
    "required": [
      "orf_project_id"
    ],
    "properties": {
      "orf_component_ref": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "orf_project_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "orf_edition_id": {
        "description": "Null is equivalent to an omitted edition; edition-specific references still require an explicit nonempty edition.",
        "type": ["string", "null"],
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
